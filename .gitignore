# yt-dlp engine (fetched at build time by scripts/fetch-ytdlp.js)
# the onedir builds unpack into binaries/<platform>/ytdlp/; the bare files are
# the single-file builds older checkouts fetched
binaries/*/ytdlp/
binaries/linux/yt-dlp
binaries/macos/yt-dlp
binaries/windows/yt-dlp.exe
!binaries/**/.gitkeep
!binaries/README.md

# Generated/temporary image files (keep essential icons)
temp_*.png
temp_*.jpg
screenshot_*.png
# Keep essential icons and assets

